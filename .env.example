# Copy this file to .env.local and fill in real values.
# WHATSAPP_NUMBER is the only one needed for Phase 1 — WhatsApp is the
# order path by default. The PAYSTACK_* ones are Phase 2: card checkout
# stays hidden and WhatsApp-only until all three are set in Vercel.

# Confirmed by the client. The number carried over from the old site
# had a stray extra digit — this is the corrected one.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348060889334

# --- Phase 2: card checkout (leave unset until the Paystack account exists) ---
# From the Paystack dashboard > Settings > API Keys & Webhooks.
# PAYSTACK_SECRET_KEY=sk_live_xxxxx or sk_test_xxxxx (server-side only, never expose this)
#
# Flip this to "true" once the two keys above are set and you want the
# "Pay with card" button to actually show on the checkout page.
# NEXT_PUBLIC_PAYSTACK_ENABLED=true
#
# Also set the webhook URL in the Paystack dashboard to:
#   https://<your-domain>/api/webhooks/paystack
# so payments still get confirmed even if a customer's browser never
# makes it back to the site after paying.
